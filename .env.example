# StanNG — optional environment configuration.
# Copy to .env and set what you need; every value below has a sane default.

# ---- server ----
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Where db.json lives. On Railway/Render attach a volume here if you want the
# database to survive redeploys.
STANNG_DATA_DIR=./data

# ---- branding ----
# These are the defaults; the panel's Settings → Branding page overrides them.
STANNG_PANEL_NAME=StanNG
STANNG_TELEGRAM_CONTACT=https://t.me/rvivl

# ---- sessions ----
STANNG_SESSION_COOKIE=stanng_session
STANNG_SESSION_MAX_AGE=604800          # 7 days, in seconds
STANNG_LOGIN_MAX_ATTEMPTS=6
STANNG_LOGIN_LOCK_SECONDS=300

# ---- reverse proxy ----
# How many proxies sit in front of the app. X-Forwarded-For is appended to by
# each hop, so the app reads the Nth entry from the right. Railway, Render and
# a single nginx are all 1. Behind Cloudflare *and* a platform router, use 2.
# Setting 0 ignores the header entirely and uses the socket address.
# Getting this wrong lets clients forge their IP and evade the login lockout.
STANNG_PROXY_HOPS=1

# Which peers uvicorn accepts forwarded headers from. Platform routers use a
# dynamic internal IP, so "*" is the practical setting there; combined with
# STANNG_PROXY_HOPS above, the trusted entry is still picked correctly.
FORWARDED_ALLOW_IPS=*

# ---- limits ----
STANNG_MAX_INBOUNDS=5000
