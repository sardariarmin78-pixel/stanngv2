# Peyk — optional environment configuration.
# Copy to .env and set what you need; every value below has a sane default.

# Every variable below also works with the pre-2.0 STANNG_ prefix, so an
# existing deployment keeps running untouched after the rename. PEYK_ wins
# when both are set.

# ---- server ----
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Where db.json lives. On Railway/Render attach a volume here if you want the
# database to survive redeploys.
PEYK_DATA_DIR=./data

# ---- branding ----
# These are the defaults; the panel's Settings → Branding page overrides them.
PEYK_PANEL_NAME=Peyk
PEYK_TELEGRAM_CONTACT=https://t.me/rvivl

# ---- sessions ----
PEYK_SESSION_COOKIE=peyk_session
PEYK_SESSION_MAX_AGE=604800          # 7 days, in seconds
PEYK_LOGIN_MAX_ATTEMPTS=6
PEYK_LOGIN_LOCK_SECONDS=300

# ---- reverse proxy ----
# How many proxies sit in front of the app. X-Forwarded-For is appended to by
# each hop, so the app reads the Nth entry from the right. Railway, Render and
# a single nginx are all 1. Behind Cloudflare *and* a platform router, use 2.
# Setting 0 ignores the header entirely and uses the socket address.
# Getting this wrong lets clients forge their IP and evade the login lockout.
PEYK_PROXY_HOPS=1

# Which peers uvicorn accepts forwarded headers from. Platform routers use a
# dynamic internal IP, so "*" is the practical setting there; combined with
# PEYK_PROXY_HOPS above, the trusted entry is still picked correctly.
FORWARDED_ALLOW_IPS=*

# ---- performance ----
# Relay worker processes. One asyncio loop saturates a single core, and
# measured aggregate throughput *falls* as concurrency rises, so "auto"
# (one per core, capped at 8) is the right default on any real server.
# Set 1 to force the old single-process behaviour.
#
# Measured on 8 cores, 24 concurrent streams:
#   1 worker  -> 1025 Mbit/s
#   8 workers -> 3661 Mbit/s   (3.6x)
#
# Multi-worker mode coordinates through data/db.lock and data/rt/*.json.
# Per-user limits converge within ~1s rather than being instantaneous.
PEYK_WORKERS=auto

# ---- limits ----
PEYK_MAX_INBOUNDS=5000
